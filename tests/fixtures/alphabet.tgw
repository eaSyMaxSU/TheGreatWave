# Every symbol, including a quoted wave whose spaces are ignored.
@title Wave alphabet
@tick 0

p: p.......
n: n.......
P: P.......
N: N.......
levels: h.l.H.L.
bits: 0101....
unknown: x.x.....
down: d.d.....
up: u.u.....
hiz: z.z.....
data: =.=.....
colors: 23456789
sub: 0.<1010>1.
gap: 01|10
spaced: "0 1 . 0"
